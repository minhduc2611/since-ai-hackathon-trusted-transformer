{
 "$schema": "http://json-schema.org/schema#",
 "$id": "https://uri.fiware.org/ns/data-models/health-ed/EDWeeklyStatistic/schema.json",
 "title": "Health ED (FIWARE proposal, flattened SDM dataModel.Hl7 profile) - EDWeeklyStatistic",
 "description": "One cell of the published weekly table: ISO week x municipality x age band x sex x diagnosis group. scope is Public/Aggregate when visitCount >= disclosureThreshold, otherwise Confidential/SmallCell.",
 "modelTags": "Health, FHIR R4B, data classification",
 "x-fhir-r4b-resource": "MeasureReport (stratified count)",
 "x-ngsi-ld-scope": [
  "/Classification/Public/Aggregate",
  "/Classification/Confidential/SmallCell"
 ],
 "type": "object",
 "required": [
  "id",
  "type",
  "scope"
 ],
 "properties": {
  "id": {
   "type": "string",
   "format": "uri"
  },
  "type": {
   "type": "string",
   "enum": [
    "EDWeeklyStatistic"
   ]
  },
  "scope": {
   "description": "NGSI-LD scope = classification tier of the entity.",
   "oneOf": [
    {
     "type": "string",
     "enum": [
      "/Classification/Public/Aggregate",
      "/Classification/Confidential/SmallCell"
     ]
    },
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   ]
  },
  "isoWeek": {
   "type": "string",
   "pattern": "^\\d{4}-W\\d{2}$",
   "description": "Property. ISO week.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.period"
  },
  "municipality": {
   "type": "string",
   "description": "Property. Municipality.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.group.stratifier"
  },
  "ageBand": {
   "type": "string",
   "description": "Property. Age band.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.group.stratifier"
  },
  "sex": {
   "type": "string",
   "enum": [
    "F",
    "M"
   ],
   "description": "Property. Sex.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.group.stratifier"
  },
  "diagnosisGroup": {
   "type": "string",
   "description": "Property. Diagnosis group.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.group.stratifier"
  },
  "visitCount": {
   "type": "integer",
   "description": "Property. Number of visits in the cell.",
   "x-ngsi-ld-classification": "per entity scope",
   "x-fhir-r4b": "MeasureReport.group.stratifier.stratum.measureScore"
  },
  "disclosureThreshold": {
   "type": "integer",
   "description": "Property. k used for the Public/SmallCell split.",
   "x-ngsi-ld-classification": "per entity scope"
  },
  "dataProvider": {
   "type": "string",
   "description": "Property. Source of the data.",
   "x-ngsi-ld-classification": "entity scope"
  }
 }
}
