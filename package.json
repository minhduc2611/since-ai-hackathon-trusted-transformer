{
  "name": "trusted-pets-transformer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TrustED PETs Transformer — Detect → Select → Transform → Demonstrate (Gemma via Ollama)",
  "scripts": {
    "detect": "tsx src/run.ts detect",
    "select": "tsx src/run.ts select",
    "transform": "tsx src/run.ts transform",
    "demonstrate": "tsx src/run.ts demonstrate",
    "pipeline": "tsx src/run.ts all",
    "server": "tsx watch src/server/index.ts",
    "web": "npm --prefix web run dev",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run web\"",
    "setup": "npm install && npm --prefix web install",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0"
  }
}
